---------------------------------------------------------
-- HITBOX
---------------------------------------------------------
local hitboxSettings = {
    enabled = false,
    size = 5,
    transparency = 0.7,
    targets = {},
    connections = {}
}

local function removeHitbox(targetPlayer)
    local data = hitboxSettings.targets[targetPlayer]
    if not data then return end

    pcall(function()
        local char = targetPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Size = data.originalSize or Vector3.new(2,2,2)
                hrp.Transparency = data.originalTransparency or 0
                hrp.CanCollide = true
            end
        end
    end)

    if data.hitboxPart then data.hitboxPart:Destroy() end
    if data.weld then data.weld:Destroy() end
    hitboxSettings.targets[targetPlayer] = nil
end

local function createHitbox(targetPlayer)
    if targetPlayer == LocalPlayer then return end
    removeHitbox(targetPlayer)

    local char = targetPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local data = {
        originalSize = hrp.Size,
        originalTransparency = hrp.Transparency,
        hitboxPart = nil,
        weld = nil
    }

    local visual = Instance.new("Part")
    visual.Name = "HitboxVisual"
    visual.Anchored = false
    visual.CanCollide = false
    visual.Size = Vector3.new(hitboxSettings.size, hitboxSettings.size, hitboxSettings.size)
    visual.Transparency = hitboxSettings.transparency
    visual.Color = Color3.fromRGB(255,0,0)
    visual.Material = Enum.Material.Neon
    visual.Parent = char

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = hrp
    weld.Part1 = visual
    weld.Parent = visual

    hrp.Size = Vector3.new(hitboxSettings.size, hitboxSettings.size, hitboxSettings.size)
    hrp.Transparency = 0.8
    hrp.CanCollide = false

    data.hitboxPart = visual
    data.weld = weld
    hitboxSettings.targets[targetPlayer] = data
end

local function setupPlayerListener(player)
    if player == LocalPlayer then return end
    if hitboxSettings.connections[player] then
        hitboxSettings.connections[player]:Disconnect()
    end
    hitboxSettings.connections[player] = player.CharacterAdded:Connect(function(char)
        if hitboxSettings.enabled then
            task.wait(0.5)
            createHitbox(player)
        end
    end)
    if player.Character and hitboxSettings.enabled then
        createHitbox(player)
    end
end

local function applyHitboxes()
    for _, player in ipairs(Players:GetPlayers()) do
        setupPlayerListener(player)
    end
end

local function clearAllHitboxes()
    for player, _ in pairs(hitboxSettings.targets) do
        removeHitbox(player)
    end
    for player, conn in pairs(hitboxSettings.connections) do
        conn:Disconnect()
    end
    hitboxSettings.targets = {}
    hitboxSettings.connections = {}
end

Players.PlayerRemoving:Connect(function(player)
    removeHitbox(player)
    if hitboxSettings.connections[player] then
        hitboxSettings.connections[player]:Disconnect()
        hitboxSettings.connections[player] = nil
    end
end)

Tabs.Combat:AddToggle("HitboxToggle", {
    Title = "Enable Hitbox",
    Default = false
}):OnChanged(function(Value)
    hitboxSettings.enabled = Value
    if Value then applyHitboxes() else clearAllHitboxes() end
end)

Tabs.Combat:AddSlider("HitboxSize", {
    Title = "Hitbox Size",
    Default = 5,
    Min = 2,
    Max = 15,
    Rounding = 1,
    Callback = function(Value)
        hitboxSettings.size = Value
        if hitboxSettings.enabled then
            local players = {}
            for plr, _ in pairs(hitboxSettings.targets) do
                table.insert(players, plr)
            end
            for _, plr in ipairs(players) do
                removeHitbox(plr)
                createHitbox(plr)
            end
        end
    end
})

Tabs.Combat:AddSlider("HitboxTransparency", {
    Title = "Hitbox Transparency",
    Default = 0.7,
    Min = 0,
    Max = 1,
    Rounding = 1,
    Callback = function(Value)
        hitboxSettings.transparency = Value
        for _, data in pairs(hitboxSettings.targets) do
            if data.hitboxPart then
                data.hitboxPart.Transparency = Value
            end
        end
    end
})

