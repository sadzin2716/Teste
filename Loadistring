-- AUTO EQUIP
---------------------------------------------------------
local autoEquipEnabled = false

task.spawn(function()
    while true do
        task.wait(0.3)
        if autoEquipEnabled then
            pcall(function()
                local character = LocalPlayer.Character
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                if character and backpack then
                    local currentTool = character:FindFirstChildOfClass("Tool")
                    local items = backpack:GetChildren()
                    local targetWeapon = nil
                    if #items >= 2 then targetWeapon = items[2]
                    elseif #items == 1 then targetWeapon = items[1] end
                    if targetWeapon and targetWeapon:IsA("Tool") then
                        if not currentTool or currentTool.Name ~= targetWeapon.Name then
                            targetWeapon.Parent = character
                        end
                    end
                end
            end)
        end
    end
end)

Tabs.Others:AddToggle("AutoEquipToggle", {
    Title = "Auto Equip Weapon",
    Default = false
}):OnChanged(function(Value)
    autoEquipEnabled = Value
end)

