-- SPEED HACK
---------------------------------------------------------
local speedSettings = {
    enabled = false,
    value = 32,
    originalSpeed = 16
}

local function updateSpeed()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = speedSettings.enabled and speedSettings.value or speedSettings.originalSpeed
    end
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    updateSpeed()
end)

Tabs.Movement:AddToggle("SpeedToggle", {
    Title = "Speed Hack",
    Default = false
}):OnChanged(function(Value)
    speedSettings.enabled = Value
    updateSpeed()
end)

Tabs.Movement:AddSlider("SpeedSlider", {
    Title = "Walk Speed",
    Default = 32,
    Min = 16,
    Max = 200,
    Rounding = 1,
    Callback = function(Value)
        speedSettings.value = Value
        if speedSettings.enabled then updateSpeed() end
    end
})

---------------------------------------------------------
-- HIGHLIGHTS
---------------------------------------------------------
local highlights = {}
local highlightEnabled = false

local function addHighlightToCharacter(character)
    if not character or character:FindFirstChild("PlayerHighlight") then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = "PlayerHighlight"
    highlight.FillColor = Color3.fromRGB(220,20,60)
    highlight.FillTransparency = 0.4
    highlight.OutlineColor = Color3.fromRGB(0,0,0)
    highlight.Adornee = character
    highlight.Parent = character
    table.insert(highlights, highlight)
end

local function applyHighlight(player)
    if player == LocalPlayer then return end
    player.CharacterAdded:Connect(function(char)
        if highlightEnabled then addHighlightToCharacter(char) end
    end)
    if player.Character and highlightEnabled then
        addHighlightToCharacter(player.Character)
    end
end

local function removeHighlights()
    for _, h in ipairs(highlights) do
        if h and h.Parent then h:Destroy() end
    end
    table.clear(highlights)
end

Tabs.Visual:AddToggle("HighlightToggle", {
    Title = "Highlights (Chams)",
    Default = false
}):OnChanged(function(Value)
    highlightEnabled = Value
    if Value then
        for _, player in ipairs(Players:GetPlayers()) do applyHighlight(player) end
    else
        removeHighlights()
    end
end)

